<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Server Status</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background: linear-gradient(135deg, #101828, #1e2939, #101828);
        color: #fff;
        text-align: center;
      }
      .container {
        border: 1px solid #364153;
        background: #101828;
        padding: 2rem 3rem;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        max-width: 400px;
      }
      h1 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }
      .button {
        background: #155dfc;
        padding: 8px 16px;
        border-radius: 8px;
        display: inline-block;
        margin-top: 1rem;
      }
      a {
        text-decoration: none;
        color: white;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Server is Awake!</h1>
      <div class="button">
        <a href="<%= FRONTEND_URL %>">Go to Api Visualizer</a>
      </div>
    </div>
  </body>
</html>
